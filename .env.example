# Public client endpoints. Never put database credentials or API admin keys in EXPO_PUBLIC_* variables.
EXPO_PUBLIC_NEON_AUTH_URL=
EXPO_PUBLIC_NEON_DATA_API_URL=
EXPO_PUBLIC_API_BASE_URL=

# Server-only Expo API route secrets. Configure these in EAS/Expo environments; never expose them as EXPO_PUBLIC_*.
OPENAI_API_KEY=
OPENAI_IMAGE_VOCAB_MODEL=gpt-5.6-luna

# Development Neon Auth currently lives on the isolated tasks-11-20 branch.
# Promote/provision production endpoints deliberately at the cloud release gate.
