# Public client endpoints only. Never put a Neon Postgres connection string or AI key in Expo.
EXPO_PUBLIC_NEON_AUTH_URL=
EXPO_PUBLIC_NEON_DATA_API_URL=
EXPO_PUBLIC_API_BASE_URL=

# Server-only EAS Hosting/API-route environment. Never prefix secrets with EXPO_PUBLIC_.
# NEON_DATA_API_URL may point to the same Data API endpoint as the public client value;
# the API route forwards the signed-in user's JWT so Neon RLS validates language-pair ownership.
NEON_DATA_API_URL=
DATABASE_URL=

# Gemini/Gemma import router. Keep this server-side only.
# The same secret name may exist in GitHub Actions for CI/manual smoke checks, but EAS runtime
# needs its own server environment secret when API Routes are deployed.
GEMINI_API_KEY=

# Temporary compatibility for the current PDF adapter while its multimodal Gemini route is completed.
OPENAI_API_KEY=
OPENAI_IMPORT_MODEL=gpt-5.6-luna

# Neon Object Storage server credentials. Mobile receives only short-lived presigned URLs.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=
AWS_REGION=us-east-2
NEON_IMPORT_BUCKET=vocab-imports

# Development Neon Auth currently lives on the isolated tasks-11-20 branch.
# Promote/provision production endpoints deliberately at the cloud release gate.
