# Public client endpoints. Never put database credentials or AI keys in EXPO_PUBLIC_* variables.
EXPO_PUBLIC_NEON_AUTH_URL=
EXPO_PUBLIC_NEON_DATA_API_URL=
EXPO_PUBLIC_API_BASE_URL=

# Server-only Cloudflare Pages Function secret.
# Configure GEMINI_API_KEY in Cloudflare for both Preview and Production.
GEMINI_API_KEY=

# Development Neon Auth currently lives on the isolated tasks-11-20 branch.
# Promote/provision production endpoints deliberately at the cloud release gate.
